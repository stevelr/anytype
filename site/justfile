# Anytype Toolbox documentation site build and preview tasks.

default_ip := "127.0.0.1"
default_port := "8000"
default_base := "http://127.0.0.1:21100"
output_dir := "../target/docs-site"
zola_version := "0.22.1"
zola := "zola"

default:
    @just --list

build:
    {{ zola }} build --force --output-dir "{{ output_dir }}"

build-at base=default_base:
    {{ zola }} build --force --base-url "{{ base }}" --output-dir "{{ output_dir }}"

serve:
    {{ zola }} serve --force \
        --interface {{ default_ip }} \
        --port {{ default_port }} \
        --output-dir "{{ output_dir }}" 

check:
    {{ zola }} check
    gate check config.toml justfile README.md content

clean:
    rm -r "{{ output_dir }}"

version:
    @echo "expected Zola {{ zola_version }}"
    {{ zola }} --version
