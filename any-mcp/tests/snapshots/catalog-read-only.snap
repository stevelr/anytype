    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Inspect the redacted Anytype endpoint, API revision, startup availability, and enabled toolsets. Returns no credentials.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object"
      },
      "name": "server_status",
      "outputSchema": {
        "$defs": {
          "ApplicationProfile": {
            "description": "Startup-selected application catalog profile.\n\nProfiles select stable sets of complete workflow contracts. They never\nchange the schema of a tool name and are independent of read-only mode.",
            "oneOf": [
              {
                "const": "compact",
                "description": "Common existing-document search, read, and exact-edit workflows.",
                "type": "string"
              },
              {
                "const": "standard",
                "description": "Complete fourteen-tool Phase 1 compatibility catalog.",
                "type": "string"
              }
            ]
          },
          "BoundedList8OfEnabledToolset": {
            "items": {
              "$ref": "#/$defs/EnabledToolset"
            },
            "maxItems": 8,
            "type": "array"
          },
          "BoundedText2048": {
            "maxLength": 2048,
            "type": "string"
          },
          "BoundedText64": {
            "maxLength": 64,
            "type": "string"
          },
          "EnabledToolset": {
            "description": "Startup-selected toolset names returned by `server_status`.",
            "oneOf": [
              {
                "const": "core",
                "description": "Server status and capability discovery.",
                "type": "string"
              },
              {
                "const": "documents",
                "description": "Search, read, and exact-edit document workflows.",
                "type": "string"
              },
              {
                "const": "discovery",
                "description": "Space and type discovery workflows.",
                "type": "string"
              },
              {
                "const": "create",
                "description": "Object creation workflow.",
                "type": "string"
              },
              {
                "const": "advanced_mutations",
                "description": "Broad object update and archive workflows.",
                "type": "string"
              },
              {
                "const": "properties",
                "description": "Property and tag discovery workflows.",
                "type": "string"
              },
              {
                "const": "templates",
                "description": "Template discovery workflows.",
                "type": "string"
              },
              {
                "const": "views",
                "description": "View and view-object discovery workflows.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "$ref": "#/$defs/BoundedText64",
            "description": "Anytype HTTP API revision used by the client."
          },
          "enabled_toolsets": {
            "$ref": "#/$defs/BoundedList8OfEnabledToolset",
            "description": "Startup-selected MCP toolsets available in this application profile."
          },
          "endpoint": {
            "$ref": "#/$defs/BoundedText2048",
            "description": "HTTP endpoint with user information, query, and fragment removed."
          },
          "grpc_available": {
            "description": "Whether configured gRPC credentials and its startup probe succeeded.",
            "type": "boolean"
          },
          "http_available": {
            "description": "Whether the authenticated HTTP startup probe succeeded.",
            "type": "boolean"
          },
          "profile": {
            "$ref": "#/$defs/ApplicationProfile",
            "description": "Startup-selected application catalog profile."
          },
          "read_only": {
            "description": "Whether mutating workflows are omitted and rejected.",
            "type": "boolean"
          }
        },
        "required": [
          "profile",
          "read_only",
          "endpoint",
          "api_version",
          "http_available",
          "grpc_available",
          "enabled_toolsets"
        ],
        "type": "object"
      }
    },
