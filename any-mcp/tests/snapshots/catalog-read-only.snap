{
  "read_only": true,
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read bounded object metadata and properties, with an optional Unicode-safe body chunk whose SHA-256 covers the complete current body.",
      "inputSchema": {
        "$defs": {
          "AnytypeReference": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "BodyCharLimit": {
            "maximum": 100000,
            "minimum": 1,
            "type": "integer"
          },
          "BodyChunkInput": {
            "additionalProperties": false,
            "description": "Shared input for character-indexed document body reads.",
            "properties": {
              "max_chars": {
                "$ref": "#/$defs/BodyCharLimit",
                "default": 20000,
                "description": "Maximum returned characters, defaulting to 20,000."
              },
              "offset": {
                "$ref": "#/$defs/BodyOffset",
                "default": 0,
                "description": "Starting character offset, defaulting to zero."
              }
            },
            "type": "object"
          },
          "BodyOffset": {
            "maximum": 100000000,
            "minimum": 0,
            "type": "integer"
          },
          "BoundedList50OfTypeKey": {
            "items": {
              "$ref": "#/$defs/TypeKey"
            },
            "maxItems": 50,
            "type": "array"
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "body": {
            "$ref": "#/$defs/BodyChunkInput",
            "description": "Optional Unicode-character-indexed body chunk request."
          },
          "object_id": {
            "$ref": "#/$defs/ObjectId",
            "description": "Stable object id; titles are deliberately not resolved."
          },
          "property_keys": {
            "$ref": "#/$defs/BoundedList50OfTypeKey",
            "description": "Explicit property projection. Omit to return all properties only when bounded."
          },
          "space": {
            "$ref": "#/$defs/AnytypeReference",
            "description": "Unique space name or id."
          }
        },
        "required": [
          "space",
          "object_id"
        ],
        "type": "object"
      },
      "name": "object_get",
      "outputSchema": {
        "$defs": {
          "BodyChunk": {
            "additionalProperties": false,
            "description": "Character-indexed body chunk.",
            "properties": {
              "next_offset": {
                "$ref": "#/$defs/BodyOffset",
                "description": "Next character offset, absent at the end."
              },
              "offset": {
                "$ref": "#/$defs/BodyOffset",
                "description": "Starting character offset."
              },
              "sha256": {
                "description": "SHA-256 of the complete current body.",
                "maxLength": 64,
                "minLength": 64,
                "type": "string"
              },
              "text": {
                "description": "UTF-8 text sliced on character boundaries.",
                "maxLength": 100000,
                "type": "string"
              },
              "total_chars": {
                "$ref": "#/$defs/BodyOffset",
                "description": "Complete body character count."
              }
            },
            "required": [
              "text",
              "offset",
              "total_chars",
              "sha256"
            ],
            "type": "object"
          },
          "BodyOffset": {
            "maximum": 100000000,
            "minimum": 0,
            "type": "integer"
          },
          "BoundedList100OfEntityId": {
            "items": {
              "$ref": "#/$defs/EntityId"
            },
            "maxItems": 100,
            "type": "array"
          },
          "BoundedList100OfProjectedTag": {
            "items": {
              "$ref": "#/$defs/ProjectedTag"
            },
            "maxItems": 100,
            "type": "array"
          },
          "BoundedList50OfProjectedProperty": {
            "items": {
              "$ref": "#/$defs/ProjectedProperty"
            },
            "maxItems": 50,
            "type": "array"
          },
          "BoundedText256": {
            "maxLength": 256,
            "type": "string"
          },
          "BoundedText4096": {
            "maxLength": 4096,
            "type": "string"
          },
          "BoundedText512": {
            "maxLength": 512,
            "type": "string"
          },
          "EntityId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "LastModified": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectOutput": {
            "additionalProperties": false,
            "description": "A bounded object together with an explicit property projection.",
            "properties": {
              "properties": {
                "$ref": "#/$defs/BoundedList50OfProjectedProperty",
                "description": "Explicitly projected properties; never an implicit full object body."
              },
              "summary": {
                "$ref": "#/$defs/ObjectSummary",
                "description": "Stable object metadata without a document body."
              }
            },
            "required": [
              "summary",
              "properties"
            ],
            "type": "object"
          },
          "ObjectResourceUri": {
            "maxLength": 1024,
            "minLength": 28,
            "pattern": "^anytype://spaces/(?!\\.{1,2}/objects/)[A-Za-z0-9._~-]+/objects/(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectSummary": {
            "additionalProperties": false,
            "description": "Compact metadata returned by object discovery and write workflows.\n\nFields are private so callers cannot mutate identifiers independently of\nthe canonical resource URI. Construct summaries with [`ObjectSummary::new`]\nand inspect them through their getters.\n\n```compile_fail\nuse any_mcp::domain::{DisplayName, ObjectId, ObjectResourceUri, ObjectSummary, SpaceId, TypeKey};\n\n# fn main() -> Result<(), Box<dyn std::error::Error>> {\nlet object_id = ObjectId::new(\"object-1\")?;\nlet space_id = SpaceId::new(\"space-1\")?;\nlet summary = ObjectSummary {\n    id: object_id.clone(),\n    name: DisplayName::new(\"Roadmap\")?,\n    type_key: TypeKey::new(\"page\")?,\n    space_id: space_id.clone(),\n    last_modified: None,\n    resource_uri: ObjectResourceUri::new(&space_id, &object_id),\n};\n# Ok(())\n# }\n```",
            "properties": {
              "id": {
                "$ref": "#/$defs/ObjectId",
                "description": "Stable Anytype object identifier."
              },
              "last_modified": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/LastModified"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "RFC 3339 last-modified value when Anytype supplies it."
              },
              "name": {
                "$ref": "#/$defs/BoundedText512",
                "description": "Display name, which may be empty for unnamed notes."
              },
              "resource_uri": {
                "$ref": "#/$defs/ObjectResourceUri",
                "description": "Canonical MCP resource URI for reading this object's body."
              },
              "space_id": {
                "$ref": "#/$defs/SpaceId",
                "description": "Stable identifier of the containing Anytype space."
              },
              "type_key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable key of the object's Anytype type."
              }
            },
            "required": [
              "id",
              "name",
              "type_key",
              "space_id",
              "resource_uri"
            ],
            "type": "object"
          },
          "ProjectedColor": {
            "description": "Closed Anytype tag colors.",
            "oneOf": [
              {
                "const": "grey",
                "description": "Grey.",
                "type": "string"
              },
              {
                "const": "yellow",
                "description": "Yellow.",
                "type": "string"
              },
              {
                "const": "orange",
                "description": "Orange.",
                "type": "string"
              },
              {
                "const": "red",
                "description": "Red.",
                "type": "string"
              },
              {
                "const": "pink",
                "description": "Pink.",
                "type": "string"
              },
              {
                "const": "purple",
                "description": "Purple.",
                "type": "string"
              },
              {
                "const": "blue",
                "description": "Blue.",
                "type": "string"
              },
              {
                "const": "ice",
                "description": "Ice.",
                "type": "string"
              },
              {
                "const": "teal",
                "description": "Teal.",
                "type": "string"
              },
              {
                "const": "lime",
                "description": "Lime.",
                "type": "string"
              }
            ]
          },
          "ProjectedDate": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "ProjectedNumber": {
            "maximum": 1000000000000000.0,
            "minimum": -1000000000000000.0,
            "type": "number"
          },
          "ProjectedProperty": {
            "additionalProperties": false,
            "description": "One closed projected property entry.",
            "properties": {
              "key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable Anytype property key."
              },
              "value": {
                "$ref": "#/$defs/ProjectedValue",
                "description": "Bounded value retaining the upstream property format."
              }
            },
            "required": [
              "key",
              "value"
            ],
            "type": "object"
          },
          "ProjectedTag": {
            "additionalProperties": false,
            "description": "Closed projected tag option.",
            "properties": {
              "color": {
                "$ref": "#/$defs/ProjectedColor",
                "description": "Closed Anytype color enumeration."
              },
              "id": {
                "$ref": "#/$defs/EntityId",
                "description": "Stable tag identifier."
              },
              "key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable tag key."
              },
              "name": {
                "$ref": "#/$defs/BoundedText256",
                "description": "Bounded tag display name."
              }
            },
            "required": [
              "id",
              "key",
              "name",
              "color"
            ],
            "type": "object"
          },
          "ProjectedValue": {
            "description": "Closed and bounded wire representation of every current `PropertyValue` variant.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Plain bounded text.",
                "properties": {
                  "format": {
                    "const": "text",
                    "type": "string"
                  },
                  "text": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded text value."
                  }
                },
                "required": [
                  "format",
                  "text"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Validated finite practical JSON number.",
                "properties": {
                  "format": {
                    "const": "number",
                    "type": "string"
                  },
                  "number": {
                    "$ref": "#/$defs/ProjectedNumber",
                    "description": "Finite bounded numeric value."
                  }
                },
                "required": [
                  "format",
                  "number"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "One closed select option.",
                "properties": {
                  "format": {
                    "const": "select",
                    "type": "string"
                  },
                  "select": {
                    "$ref": "#/$defs/ProjectedTag",
                    "description": "Selected tag option."
                  }
                },
                "required": [
                  "format",
                  "select"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "A bounded list of closed select options.",
                "properties": {
                  "format": {
                    "const": "multi_select",
                    "type": "string"
                  },
                  "multi_select": {
                    "$ref": "#/$defs/BoundedList100OfProjectedTag",
                    "description": "Selected tag options."
                  }
                },
                "required": [
                  "format",
                  "multi_select"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded RFC 3339-like upstream date text.",
                "properties": {
                  "date": {
                    "$ref": "#/$defs/ProjectedDate",
                    "description": "Bounded date text."
                  },
                  "format": {
                    "const": "date",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "date"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded file references.",
                "properties": {
                  "files": {
                    "$ref": "#/$defs/BoundedList100OfEntityId",
                    "description": "Validated file identifiers."
                  },
                  "format": {
                    "const": "files",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "files"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Boolean checkbox value.",
                "properties": {
                  "checkbox": {
                    "description": "Checkbox state.",
                    "type": "boolean"
                  },
                  "format": {
                    "const": "checkbox",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "checkbox"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded URL value.",
                "properties": {
                  "format": {
                    "const": "url",
                    "type": "string"
                  },
                  "url": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded URL text."
                  }
                },
                "required": [
                  "format",
                  "url"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded email value.",
                "properties": {
                  "email": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded email text."
                  },
                  "format": {
                    "const": "email",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "email"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded phone value.",
                "properties": {
                  "format": {
                    "const": "phone",
                    "type": "string"
                  },
                  "phone": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded phone text."
                  }
                },
                "required": [
                  "format",
                  "phone"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded validated object identifiers.",
                "properties": {
                  "format": {
                    "const": "objects",
                    "type": "string"
                  },
                  "objects": {
                    "$ref": "#/$defs/BoundedList100OfEntityId",
                    "description": "Validated referenced object identifiers."
                  }
                },
                "required": [
                  "format",
                  "objects"
                ],
                "type": "object"
              }
            ]
          },
          "SpaceId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "body": {
            "$ref": "#/$defs/BodyChunk",
            "description": "Requested body chunk, absent when no body was requested."
          },
          "object": {
            "$ref": "#/$defs/ObjectOutput",
            "description": "Stable metadata and the explicit bounded property projection."
          }
        },
        "required": [
          "object"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Search one bounded Anytype page. Returns summaries and only explicitly projected properties, never document bodies. Boolean and numeric filters are passed through unchanged and may fail due to upstream anytype-heart#2879.",
      "inputSchema": {
        "$defs": {
          "AnytypeReference": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "ArrayCondition": {
            "description": "Operators supported for multi-value properties.",
            "oneOf": [
              {
                "const": "in",
                "description": "Match at least one supplied value.",
                "type": "string"
              },
              {
                "const": "not_in",
                "description": "Match none of the supplied values.",
                "type": "string"
              },
              {
                "const": "all_in",
                "description": "Require all supplied values.",
                "type": "string"
              }
            ]
          },
          "BoundedList100OfAnytypeReference": {
            "items": {
              "$ref": "#/$defs/AnytypeReference"
            },
            "maxItems": 100,
            "type": "array"
          },
          "BoundedList50OfTypeKey": {
            "items": {
              "$ref": "#/$defs/TypeKey"
            },
            "maxItems": 50,
            "type": "array"
          },
          "BoundedText4096": {
            "maxLength": 4096,
            "type": "string"
          },
          "BoundedText64": {
            "maxLength": 64,
            "type": "string"
          },
          "CheckboxCondition": {
            "description": "Operators supported for checkbox properties.",
            "oneOf": [
              {
                "const": "eq",
                "description": "Equal.",
                "type": "string"
              },
              {
                "const": "ne",
                "description": "Not equal.",
                "type": "string"
              }
            ]
          },
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "DateCondition": {
            "description": "Operators supported for dates.",
            "oneOf": [
              {
                "const": "eq",
                "description": "Equal.",
                "type": "string"
              },
              {
                "const": "lt",
                "description": "Less than.",
                "type": "string"
              },
              {
                "const": "lte",
                "description": "Less than or equal.",
                "type": "string"
              },
              {
                "const": "gt",
                "description": "Greater than.",
                "type": "string"
              },
              {
                "const": "gte",
                "description": "Greater than or equal.",
                "type": "string"
              },
              {
                "const": "in",
                "description": "Match a date value accepted by Anytype's `in` condition.",
                "type": "string"
              }
            ]
          },
          "EntityId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "FilterNumber": {
            "maximum": 1000000000000000.0,
            "minimum": -1000000000000000.0,
            "type": "number"
          },
          "FilterOperator": {
            "description": "Logical operator for one bounded filter group.",
            "oneOf": [
              {
                "const": "and",
                "description": "Require every condition and nested group.",
                "type": "string"
              },
              {
                "const": "or",
                "description": "Require at least one condition or nested group.",
                "type": "string"
              }
            ]
          },
          "McpFilter": {
            "description": "One constrained Anytype property filter shared by MCP workflows.\n\nThe tagged form prevents ambiguous free-form JSON and maps one-to-one to\nthe supported [`anytype::filters::Filter`] variants. Checkbox and numeric\nfilters are forwarded exactly as supplied. They are currently affected by\nupstream `anytype-heart#2879`; this server does not rewrite them into a\nquery with different semantics.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Plain text property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/TextCondition",
                    "description": "Text operator."
                  },
                  "format": {
                    "const": "text",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "value": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Compared text."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Numeric property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/NumberCondition",
                    "description": "Numeric operator."
                  },
                  "format": {
                    "const": "number",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "value": {
                    "$ref": "#/$defs/FilterNumber",
                    "description": "Compared number."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Single-select property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/SelectCondition",
                    "description": "Select operator."
                  },
                  "format": {
                    "const": "select",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "values": {
                    "$ref": "#/$defs/NonEmptyFilterValueList100OfSelectReference",
                    "description": "Compared tag ids or keys."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "values"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Multi-select property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/ArrayCondition",
                    "description": "Array operator."
                  },
                  "format": {
                    "const": "multi_select",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "values": {
                    "$ref": "#/$defs/NonEmptyFilterValueList100OfSelectReference",
                    "description": "Compared tag ids or keys."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "values"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "RFC 3339-like date property value accepted by Anytype.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/DateCondition",
                    "description": "Date operator."
                  },
                  "format": {
                    "const": "date",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "value": {
                    "$ref": "#/$defs/BoundedText64",
                    "description": "Compared date text."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Checkbox property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/CheckboxCondition",
                    "description": "Boolean operator."
                  },
                  "format": {
                    "const": "checkbox",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "value": {
                    "description": "Compared checkbox state.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "File-reference property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/ArrayCondition",
                    "description": "Array operator."
                  },
                  "format": {
                    "const": "files",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "values": {
                    "$ref": "#/$defs/NonEmptyFilterValueList100OfEntityId",
                    "description": "Compared file ids."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "values"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "URL property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/TextCondition",
                    "description": "Text operator."
                  },
                  "format": {
                    "const": "url",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "value": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Compared URL text."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Email property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/TextCondition",
                    "description": "Text operator."
                  },
                  "format": {
                    "const": "email",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "value": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Compared email text."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Phone property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/TextCondition",
                    "description": "Text operator."
                  },
                  "format": {
                    "const": "phone",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "value": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Compared phone text."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Object-reference property.",
                "properties": {
                  "condition": {
                    "$ref": "#/$defs/ArrayCondition",
                    "description": "Array operator."
                  },
                  "format": {
                    "const": "objects",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  },
                  "values": {
                    "$ref": "#/$defs/NonEmptyFilterValueList100OfObjectId",
                    "description": "Compared object ids."
                  }
                },
                "required": [
                  "format",
                  "property_key",
                  "condition",
                  "values"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Require a property to be empty.",
                "properties": {
                  "format": {
                    "const": "empty",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  }
                },
                "required": [
                  "format",
                  "property_key"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Require a property to be present and nonempty.",
                "properties": {
                  "format": {
                    "const": "not_empty",
                    "type": "string"
                  },
                  "property_key": {
                    "$ref": "#/$defs/TypeKey",
                    "description": "Property key."
                  }
                },
                "required": [
                  "format",
                  "property_key"
                ],
                "type": "object"
              }
            ]
          },
          "McpFilterExpression": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "conditions": {
                    "default": [],
                    "description": "Direct conditions in this group.",
                    "items": {
                      "$ref": "#/$defs/McpFilter"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array"
                  },
                  "filters": {
                    "default": [],
                    "description": "Nested groups in this group.",
                    "items": {
                      "$ref": "#/$defs/McpFilterExpression"
                    },
                    "maxItems": 50,
                    "minItems": 0,
                    "type": "array"
                  },
                  "operator": {
                    "$ref": "#/$defs/FilterOperator",
                    "description": "Operator combining direct conditions and child groups."
                  }
                },
                "required": [
                  "operator",
                  "conditions"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "conditions": {
                    "default": [],
                    "description": "Direct conditions in this group.",
                    "items": {
                      "$ref": "#/$defs/McpFilter"
                    },
                    "maxItems": 50,
                    "minItems": 0,
                    "type": "array"
                  },
                  "filters": {
                    "default": [],
                    "description": "Nested groups in this group.",
                    "items": {
                      "$ref": "#/$defs/McpFilterExpression"
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array"
                  },
                  "operator": {
                    "$ref": "#/$defs/FilterOperator",
                    "description": "Operator combining direct conditions and child groups."
                  }
                },
                "required": [
                  "operator",
                  "filters"
                ],
                "type": "object"
              }
            ],
            "description": "One nested, bounded filter expression shared by MCP workflows. At least one of conditions or filters must be present and nonempty."
          },
          "NonEmptyFilterValueList100OfEntityId": {
            "items": {
              "$ref": "#/$defs/EntityId"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "NonEmptyFilterValueList100OfObjectId": {
            "items": {
              "$ref": "#/$defs/ObjectId"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "NonEmptyFilterValueList100OfSelectReference": {
            "items": {
              "$ref": "#/$defs/SelectReference"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "NumberCondition": {
            "description": "Operators supported for numeric properties.",
            "oneOf": [
              {
                "const": "eq",
                "description": "Equal.",
                "type": "string"
              },
              {
                "const": "ne",
                "description": "Not equal.",
                "type": "string"
              },
              {
                "const": "lt",
                "description": "Less than.",
                "type": "string"
              },
              {
                "const": "lte",
                "description": "Less than or equal.",
                "type": "string"
              },
              {
                "const": "gt",
                "description": "Greater than.",
                "type": "string"
              },
              {
                "const": "gte",
                "description": "Greater than or equal.",
                "type": "string"
              }
            ]
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "PageLimit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "SearchSort": {
            "additionalProperties": false,
            "description": "One explicit search sort.",
            "properties": {
              "direction": {
                "$ref": "#/$defs/SearchSortDirection",
                "description": "Sort direction."
              },
              "property_key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Anytype property key used for sorting."
              }
            },
            "required": [
              "property_key",
              "direction"
            ],
            "type": "object"
          },
          "SearchSortDirection": {
            "description": "Search sort direction.",
            "oneOf": [
              {
                "const": "asc",
                "description": "Sort from the smallest/oldest value to the largest/newest.",
                "type": "string"
              },
              {
                "const": "desc",
                "description": "Sort from the largest/newest value to the smallest/oldest.",
                "type": "string"
              }
            ]
          },
          "SelectCondition": {
            "description": "Operators supported for a single-select property.",
            "oneOf": [
              {
                "const": "in",
                "description": "Match one of the supplied values.",
                "type": "string"
              },
              {
                "const": "not_in",
                "description": "Match none of the supplied values.",
                "type": "string"
              }
            ]
          },
          "SelectReference": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": "^[^,]+$",
            "type": "string"
          },
          "TextCondition": {
            "description": "Operators supported for textual property formats.",
            "oneOf": [
              {
                "const": "eq",
                "description": "Equal.",
                "type": "string"
              },
              {
                "const": "ne",
                "description": "Not equal.",
                "type": "string"
              },
              {
                "const": "contains",
                "description": "Contains the supplied text.",
                "type": "string"
              },
              {
                "const": "not_contains",
                "description": "Does not contain the supplied text.",
                "type": "string"
              }
            ]
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "$ref": "#/$defs/CursorToken",
            "description": "Opaque continuation cursor."
          },
          "filters": {
            "$ref": "#/$defs/McpFilterExpression",
            "description": "Optional bounded nested filter expression."
          },
          "limit": {
            "$ref": "#/$defs/PageLimit",
            "default": 20,
            "description": "Requested item limit, defaulting to 20."
          },
          "property_keys": {
            "$ref": "#/$defs/BoundedList50OfTypeKey",
            "default": [],
            "description": "Properties to project into each summary; omitted keys are never returned."
          },
          "sort": {
            "$ref": "#/$defs/SearchSort",
            "description": "Optional single property sort."
          },
          "space": {
            "$ref": "#/$defs/AnytypeReference",
            "description": "Optional unique space name or id. Omit for a global search."
          },
          "text": {
            "$ref": "#/$defs/BoundedText4096",
            "description": "Optional text searched by Anytype in names and content."
          },
          "types": {
            "$ref": "#/$defs/BoundedList100OfAnytypeReference",
            "default": [],
            "description": "Type keys, names, or ids for a space search; global searches accept keys."
          }
        },
        "type": "object"
      },
      "name": "object_search",
      "outputSchema": {
        "$defs": {
          "BoundedList100OfEntityId": {
            "items": {
              "$ref": "#/$defs/EntityId"
            },
            "maxItems": 100,
            "type": "array"
          },
          "BoundedList100OfProjectedTag": {
            "items": {
              "$ref": "#/$defs/ProjectedTag"
            },
            "maxItems": 100,
            "type": "array"
          },
          "BoundedList50OfProjectedProperty": {
            "items": {
              "$ref": "#/$defs/ProjectedProperty"
            },
            "maxItems": 50,
            "type": "array"
          },
          "BoundedText256": {
            "maxLength": 256,
            "type": "string"
          },
          "BoundedText4096": {
            "maxLength": 4096,
            "type": "string"
          },
          "BoundedText512": {
            "maxLength": 512,
            "type": "string"
          },
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "EntityId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "LastModified": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectOutput": {
            "additionalProperties": false,
            "description": "A bounded object together with an explicit property projection.",
            "properties": {
              "properties": {
                "$ref": "#/$defs/BoundedList50OfProjectedProperty",
                "description": "Explicitly projected properties; never an implicit full object body."
              },
              "summary": {
                "$ref": "#/$defs/ObjectSummary",
                "description": "Stable object metadata without a document body."
              }
            },
            "required": [
              "summary",
              "properties"
            ],
            "type": "object"
          },
          "ObjectResourceUri": {
            "maxLength": 1024,
            "minLength": 28,
            "pattern": "^anytype://spaces/(?!\\.{1,2}/objects/)[A-Za-z0-9._~-]+/objects/(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectSummary": {
            "additionalProperties": false,
            "description": "Compact metadata returned by object discovery and write workflows.\n\nFields are private so callers cannot mutate identifiers independently of\nthe canonical resource URI. Construct summaries with [`ObjectSummary::new`]\nand inspect them through their getters.\n\n```compile_fail\nuse any_mcp::domain::{DisplayName, ObjectId, ObjectResourceUri, ObjectSummary, SpaceId, TypeKey};\n\n# fn main() -> Result<(), Box<dyn std::error::Error>> {\nlet object_id = ObjectId::new(\"object-1\")?;\nlet space_id = SpaceId::new(\"space-1\")?;\nlet summary = ObjectSummary {\n    id: object_id.clone(),\n    name: DisplayName::new(\"Roadmap\")?,\n    type_key: TypeKey::new(\"page\")?,\n    space_id: space_id.clone(),\n    last_modified: None,\n    resource_uri: ObjectResourceUri::new(&space_id, &object_id),\n};\n# Ok(())\n# }\n```",
            "properties": {
              "id": {
                "$ref": "#/$defs/ObjectId",
                "description": "Stable Anytype object identifier."
              },
              "last_modified": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/LastModified"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "RFC 3339 last-modified value when Anytype supplies it."
              },
              "name": {
                "$ref": "#/$defs/BoundedText512",
                "description": "Display name, which may be empty for unnamed notes."
              },
              "resource_uri": {
                "$ref": "#/$defs/ObjectResourceUri",
                "description": "Canonical MCP resource URI for reading this object's body."
              },
              "space_id": {
                "$ref": "#/$defs/SpaceId",
                "description": "Stable identifier of the containing Anytype space."
              },
              "type_key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable key of the object's Anytype type."
              }
            },
            "required": [
              "id",
              "name",
              "type_key",
              "space_id",
              "resource_uri"
            ],
            "type": "object"
          },
          "ProjectedColor": {
            "description": "Closed Anytype tag colors.",
            "oneOf": [
              {
                "const": "grey",
                "description": "Grey.",
                "type": "string"
              },
              {
                "const": "yellow",
                "description": "Yellow.",
                "type": "string"
              },
              {
                "const": "orange",
                "description": "Orange.",
                "type": "string"
              },
              {
                "const": "red",
                "description": "Red.",
                "type": "string"
              },
              {
                "const": "pink",
                "description": "Pink.",
                "type": "string"
              },
              {
                "const": "purple",
                "description": "Purple.",
                "type": "string"
              },
              {
                "const": "blue",
                "description": "Blue.",
                "type": "string"
              },
              {
                "const": "ice",
                "description": "Ice.",
                "type": "string"
              },
              {
                "const": "teal",
                "description": "Teal.",
                "type": "string"
              },
              {
                "const": "lime",
                "description": "Lime.",
                "type": "string"
              }
            ]
          },
          "ProjectedDate": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "ProjectedNumber": {
            "maximum": 1000000000000000.0,
            "minimum": -1000000000000000.0,
            "type": "number"
          },
          "ProjectedProperty": {
            "additionalProperties": false,
            "description": "One closed projected property entry.",
            "properties": {
              "key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable Anytype property key."
              },
              "value": {
                "$ref": "#/$defs/ProjectedValue",
                "description": "Bounded value retaining the upstream property format."
              }
            },
            "required": [
              "key",
              "value"
            ],
            "type": "object"
          },
          "ProjectedTag": {
            "additionalProperties": false,
            "description": "Closed projected tag option.",
            "properties": {
              "color": {
                "$ref": "#/$defs/ProjectedColor",
                "description": "Closed Anytype color enumeration."
              },
              "id": {
                "$ref": "#/$defs/EntityId",
                "description": "Stable tag identifier."
              },
              "key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable tag key."
              },
              "name": {
                "$ref": "#/$defs/BoundedText256",
                "description": "Bounded tag display name."
              }
            },
            "required": [
              "id",
              "key",
              "name",
              "color"
            ],
            "type": "object"
          },
          "ProjectedValue": {
            "description": "Closed and bounded wire representation of every current `PropertyValue` variant.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Plain bounded text.",
                "properties": {
                  "format": {
                    "const": "text",
                    "type": "string"
                  },
                  "text": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded text value."
                  }
                },
                "required": [
                  "format",
                  "text"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Validated finite practical JSON number.",
                "properties": {
                  "format": {
                    "const": "number",
                    "type": "string"
                  },
                  "number": {
                    "$ref": "#/$defs/ProjectedNumber",
                    "description": "Finite bounded numeric value."
                  }
                },
                "required": [
                  "format",
                  "number"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "One closed select option.",
                "properties": {
                  "format": {
                    "const": "select",
                    "type": "string"
                  },
                  "select": {
                    "$ref": "#/$defs/ProjectedTag",
                    "description": "Selected tag option."
                  }
                },
                "required": [
                  "format",
                  "select"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "A bounded list of closed select options.",
                "properties": {
                  "format": {
                    "const": "multi_select",
                    "type": "string"
                  },
                  "multi_select": {
                    "$ref": "#/$defs/BoundedList100OfProjectedTag",
                    "description": "Selected tag options."
                  }
                },
                "required": [
                  "format",
                  "multi_select"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded RFC 3339-like upstream date text.",
                "properties": {
                  "date": {
                    "$ref": "#/$defs/ProjectedDate",
                    "description": "Bounded date text."
                  },
                  "format": {
                    "const": "date",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "date"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded file references.",
                "properties": {
                  "files": {
                    "$ref": "#/$defs/BoundedList100OfEntityId",
                    "description": "Validated file identifiers."
                  },
                  "format": {
                    "const": "files",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "files"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Boolean checkbox value.",
                "properties": {
                  "checkbox": {
                    "description": "Checkbox state.",
                    "type": "boolean"
                  },
                  "format": {
                    "const": "checkbox",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "checkbox"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded URL value.",
                "properties": {
                  "format": {
                    "const": "url",
                    "type": "string"
                  },
                  "url": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded URL text."
                  }
                },
                "required": [
                  "format",
                  "url"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded email value.",
                "properties": {
                  "email": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded email text."
                  },
                  "format": {
                    "const": "email",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "email"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded phone value.",
                "properties": {
                  "format": {
                    "const": "phone",
                    "type": "string"
                  },
                  "phone": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded phone text."
                  }
                },
                "required": [
                  "format",
                  "phone"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded validated object identifiers.",
                "properties": {
                  "format": {
                    "const": "objects",
                    "type": "string"
                  },
                  "objects": {
                    "$ref": "#/$defs/BoundedList100OfEntityId",
                    "description": "Validated referenced object identifiers."
                  }
                },
                "required": [
                  "format",
                  "objects"
                ],
                "type": "object"
              }
            ]
          },
          "SpaceId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Items in this page, never more than 100.",
            "items": {
              "$ref": "#/$defs/ObjectOutput"
            },
            "maxItems": 100,
            "type": "array"
          },
          "next_cursor": {
            "$ref": "#/$defs/CursorToken",
            "description": "Opaque continuation cursor, absent at the end."
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List one bounded page of property definitions and tag counts. Does not return tag options.",
      "inputSchema": {
        "$defs": {
          "CursorToken": {
            "maxLength": 64,
