          }
        },
        "required": [
          "space",
          "type"
        ],
        "type": "object"
      },
      "name": "template_list",
      "outputSchema": {
        "$defs": {
          "BoundedText512": {
            "maxLength": 512,
            "type": "string"
          },
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "LastModified": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectResourceUri": {
            "maxLength": 1024,
            "minLength": 28,
            "pattern": "^anytype://spaces/(?!\\.{1,2}/objects/)[A-Za-z0-9._~-]+/objects/(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectSummary": {
            "additionalProperties": false,
            "description": "Compact metadata returned by object discovery and write workflows.\n\nFields are private so callers cannot mutate identifiers independently of\nthe canonical resource URI. Construct summaries with [`ObjectSummary::new`]\nand inspect them through their getters.\n\n```compile_fail\nuse any_mcp::domain::{DisplayName, ObjectId, ObjectResourceUri, ObjectSummary, SpaceId, TypeKey};\n\n# fn main() -> Result<(), Box<dyn std::error::Error>> {\nlet object_id = ObjectId::new(\"object-1\")?;\nlet space_id = SpaceId::new(\"space-1\")?;\nlet summary = ObjectSummary {\n    id: object_id.clone(),\n    name: DisplayName::new(\"Roadmap\")?,\n    type_key: TypeKey::new(\"page\")?,\n    space_id: space_id.clone(),\n    last_modified: None,\n    resource_uri: ObjectResourceUri::new(&space_id, &object_id),\n};\n# Ok(())\n# }\n```",
            "properties": {
              "id": {
                "$ref": "#/$defs/ObjectId",
                "description": "Stable Anytype object identifier."
              },
              "last_modified": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/LastModified"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "RFC 3339 last-modified value when Anytype supplies it."
              },
              "name": {
                "$ref": "#/$defs/BoundedText512",
                "description": "Display name, which may be empty for unnamed notes."
              },
              "resource_uri": {
                "$ref": "#/$defs/ObjectResourceUri",
                "description": "Canonical MCP resource URI for reading this object's body."
              },
              "space_id": {
                "$ref": "#/$defs/SpaceId",
                "description": "Stable identifier of the containing Anytype space."
              },
              "type_key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable key of the object's Anytype type."
              }
            },
            "required": [
              "id",
              "name",
              "type_key",
              "space_id",
              "resource_uri"
            ],
            "type": "object"
          },
          "SpaceId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Items in this page, never more than 100.",
            "items": {
              "$ref": "#/$defs/ObjectSummary"
            },
            "maxItems": 100,
            "type": "array"
          },
          "next_cursor": {
            "$ref": "#/$defs/CursorToken",
            "description": "Opaque continuation cursor, absent at the end."
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
