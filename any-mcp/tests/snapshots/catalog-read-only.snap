      "name": "type_list",
      "outputSchema": {
        "$defs": {
          "BoundedText512": {
            "maxLength": 512,
            "type": "string"
          },
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "EntityId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "TypeLayoutSummary": {
            "description": "Closed Anytype object layouts used by type discovery.",
            "oneOf": [
              {
                "const": "basic",
                "description": "Standard object layout.",
                "type": "string"
              },
              {
                "const": "profile",
                "description": "Profile layout.",
                "type": "string"
              },
              {
                "const": "action",
                "description": "Action or task layout.",
                "type": "string"
              },
              {
                "const": "note",
                "description": "Note layout.",
                "type": "string"
              },
              {
                "const": "bookmark",
                "description": "Bookmark layout.",
                "type": "string"
              },
              {
                "const": "set",
                "description": "Query-set layout.",
                "type": "string"
              },
              {
                "const": "collection",
                "description": "Collection layout.",
                "type": "string"
              },
              {
                "const": "participant",
                "description": "Participant layout.",
                "type": "string"
              },
              {
                "const": "chat",
                "description": "Chat layout.",
                "type": "string"
              }
            ]
          },
          "TypeSummary": {
            "additionalProperties": false,
            "description": "Concise active Anytype type summary.",
            "properties": {
              "id": {
                "$ref": "#/$defs/EntityId",
                "description": "Stable type identifier."
              },
              "key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable type key."
              },
              "layout": {
                "$ref": "#/$defs/TypeLayoutSummary",
                "description": "Closed default object layout."
              },
              "name": {
                "$ref": "#/$defs/BoundedText512",
                "description": "Bounded display name, falling back to the key when absent."
              }
            },
            "required": [
              "id",
              "key",
              "name",
              "layout"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Items in this page, never more than 100.",
            "items": {
              "$ref": "#/$defs/TypeSummary"
            },
            "maxItems": 100,
            "type": "array"
          },
          "next_cursor": {
            "$ref": "#/$defs/CursorToken",
            "description": "Opaque continuation cursor, absent at the end."
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List one bounded page of views for a collection or query; returns no objects.",
      "inputSchema": {
        "$defs": {
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "PageLimit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "ResolvableReference": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "$ref": "#/$defs/CursorToken"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque continuation cursor from a preceding `view_list` call."
          },
          "limit": {
            "$ref": "#/$defs/PageLimit",
            "default": 20,
            "description": "Requested item limit, defaulting to 20."
          },
          "list_id": {
            "$ref": "#/$defs/ObjectId",
            "description": "Stable collection or query object identifier."
          },
          "space": {
            "$ref": "#/$defs/ResolvableReference",
            "description": "Unique space name or identifier."
          }
        },
        "required": [
          "space",
          "list_id"
        ],
        "type": "object"
      },
      "name": "view_list",
      "outputSchema": {
        "$defs": {
          "BoundedText512": {
            "maxLength": 512,
            "type": "string"
          },
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "EntityId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ViewLayout": {
            "description": "Closed Anytype view layouts exposed by `view_list`.",
            "oneOf": [
              {
                "const": "calendar",
                "description": "Calendar view.",
                "type": "string"
              },
              {
                "const": "gallery",
                "description": "Gallery view.",
                "type": "string"
              },
              {
                "const": "graph",
                "description": "Graph view.",
                "type": "string"
              },
              {
                "const": "grid",
                "description": "Grid/table view.",
                "type": "string"
              },
              {
                "const": "kanban",
                "description": "Kanban view.",
                "type": "string"
              },
              {
                "const": "list",
                "description": "List view.",
                "type": "string"
              }
            ]
          },
          "ViewSummary": {
            "additionalProperties": false,
            "description": "Bounded metadata for one view of a collection or query.",
            "properties": {
              "id": {
                "$ref": "#/$defs/EntityId",
                "description": "Stable view identifier accepted by `view_object_list`."
              },
              "layout": {
                "$ref": "#/$defs/ViewLayout",
                "description": "Closed layout classification."
              },
              "name": {
                "$ref": "#/$defs/BoundedText512",
                "description": "Bounded display name; unnamed upstream views use an empty name."
              }
            },
            "required": [
              "id",
              "name",
              "layout"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Items in this page, never more than 100.",
            "items": {
              "$ref": "#/$defs/ViewSummary"
            },
            "maxItems": 100,
            "type": "array"
          },
          "next_cursor": {
            "$ref": "#/$defs/CursorToken",
            "description": "Opaque continuation cursor, absent at the end."
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List bounded object summaries for one resolved view; bodies are never returned.",
      "inputSchema": {
        "$defs": {
          "BoundedList50OfTypeKey": {
            "items": {
              "$ref": "#/$defs/TypeKey"
            },
            "maxItems": 50,
            "type": "array"
          },
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "PageLimit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "ResolvableReference": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "$ref": "#/$defs/CursorToken"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque continuation cursor from a preceding `view_object_list` call."
          },
          "limit": {
            "$ref": "#/$defs/PageLimit",
            "default": 20,
            "description": "Requested item limit, defaulting to 20."
          },
          "list_id": {
            "$ref": "#/$defs/ObjectId",
            "description": "Stable collection or query object identifier."
          },
          "property_keys": {
            "anyOf": [
              {
                "$ref": "#/$defs/BoundedList50OfTypeKey"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional bounded property keys to project; absence returns summaries only."
          },
          "space": {
            "$ref": "#/$defs/ResolvableReference",
            "description": "Unique space name or identifier."
          },
          "view": {
            "$ref": "#/$defs/ResolvableReference",
            "description": "Unique view name or identifier within `list_id`."
          }
        },
        "required": [
          "space",
          "list_id",
          "view"
        ],
        "type": "object"
      },
      "name": "view_object_list",
      "outputSchema": {
        "$defs": {
          "BoundedList100OfEntityId": {
            "items": {
              "$ref": "#/$defs/EntityId"
            },
            "maxItems": 100,
            "type": "array"
          },
          "BoundedList100OfProjectedTag": {
            "items": {
              "$ref": "#/$defs/ProjectedTag"
            },
            "maxItems": 100,
            "type": "array"
          },
          "BoundedList50OfProjectedProperty": {
            "items": {
              "$ref": "#/$defs/ProjectedProperty"
            },
            "maxItems": 50,
            "type": "array"
          },
          "BoundedText256": {
            "maxLength": 256,
            "type": "string"
          },
          "BoundedText4096": {
            "maxLength": 4096,
            "type": "string"
          },
          "BoundedText512": {
            "maxLength": 512,
            "type": "string"
          },
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "EntityId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "LastModified": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "ObjectId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectOutput": {
            "additionalProperties": false,
            "description": "A bounded object together with an explicit property projection.",
            "properties": {
              "properties": {
                "$ref": "#/$defs/BoundedList50OfProjectedProperty",
                "description": "Explicitly projected properties; never an implicit full object body."
              },
              "summary": {
                "$ref": "#/$defs/ObjectSummary",
                "description": "Stable object metadata without a document body."
              }
            },
            "required": [
              "summary",
              "properties"
            ],
            "type": "object"
          },
          "ObjectResourceUri": {
            "maxLength": 1024,
            "minLength": 28,
            "pattern": "^anytype://spaces/(?!\\.{1,2}/objects/)[A-Za-z0-9._~-]+/objects/(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "ObjectSummary": {
            "additionalProperties": false,
            "description": "Compact metadata returned by object discovery and write workflows.\n\nFields are private so callers cannot mutate identifiers independently of\nthe canonical resource URI. Construct summaries with [`ObjectSummary::new`]\nand inspect them through their getters.\n\n```compile_fail\nuse any_mcp::domain::{DisplayName, ObjectId, ObjectResourceUri, ObjectSummary, SpaceId, TypeKey};\n\n# fn main() -> Result<(), Box<dyn std::error::Error>> {\nlet object_id = ObjectId::new(\"object-1\")?;\nlet space_id = SpaceId::new(\"space-1\")?;\nlet summary = ObjectSummary {\n    id: object_id.clone(),\n    name: DisplayName::new(\"Roadmap\")?,\n    type_key: TypeKey::new(\"page\")?,\n    space_id: space_id.clone(),\n    last_modified: None,\n    resource_uri: ObjectResourceUri::new(&space_id, &object_id),\n};\n# Ok(())\n# }\n```",
            "properties": {
              "id": {
                "$ref": "#/$defs/ObjectId",
                "description": "Stable Anytype object identifier."
              },
              "last_modified": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/LastModified"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "RFC 3339 last-modified value when Anytype supplies it."
              },
              "name": {
                "$ref": "#/$defs/BoundedText512",
                "description": "Display name, which may be empty for unnamed notes."
              },
              "resource_uri": {
                "$ref": "#/$defs/ObjectResourceUri",
                "description": "Canonical MCP resource URI for reading this object's body."
              },
              "space_id": {
                "$ref": "#/$defs/SpaceId",
                "description": "Stable identifier of the containing Anytype space."
              },
              "type_key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable key of the object's Anytype type."
              }
            },
            "required": [
              "id",
              "name",
              "type_key",
              "space_id",
              "resource_uri"
            ],
            "type": "object"
          },
          "ProjectedColor": {
            "description": "Closed Anytype tag colors.",
            "oneOf": [
              {
                "const": "grey",
                "description": "Grey.",
                "type": "string"
              },
              {
                "const": "yellow",
                "description": "Yellow.",
                "type": "string"
              },
              {
                "const": "orange",
                "description": "Orange.",
                "type": "string"
              },
              {
                "const": "red",
                "description": "Red.",
                "type": "string"
              },
              {
                "const": "pink",
                "description": "Pink.",
                "type": "string"
              },
              {
                "const": "purple",
                "description": "Purple.",
                "type": "string"
              },
              {
                "const": "blue",
                "description": "Blue.",
                "type": "string"
              },
              {
                "const": "ice",
                "description": "Ice.",
                "type": "string"
              },
              {
                "const": "teal",
                "description": "Teal.",
                "type": "string"
              },
              {
                "const": "lime",
                "description": "Lime.",
                "type": "string"
              }
            ]
          },
          "ProjectedDate": {
            "format": "date-time",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "ProjectedNumber": {
            "maximum": 1000000000000000.0,
            "minimum": -1000000000000000.0,
            "type": "number"
          },
          "ProjectedProperty": {
            "additionalProperties": false,
            "description": "One closed projected property entry.",
            "properties": {
              "key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable Anytype property key."
              },
              "value": {
                "$ref": "#/$defs/ProjectedValue",
                "description": "Bounded value retaining the upstream property format."
              }
            },
            "required": [
              "key",
              "value"
            ],
            "type": "object"
          },
          "ProjectedTag": {
            "additionalProperties": false,
            "description": "Closed projected tag option.",
            "properties": {
              "color": {
                "$ref": "#/$defs/ProjectedColor",
                "description": "Closed Anytype color enumeration."
              },
              "id": {
                "$ref": "#/$defs/EntityId",
                "description": "Stable tag identifier."
              },
              "key": {
                "$ref": "#/$defs/TypeKey",
                "description": "Stable tag key."
              },
              "name": {
                "$ref": "#/$defs/BoundedText256",
                "description": "Bounded tag display name."
              }
            },
            "required": [
              "id",
              "key",
              "name",
              "color"
            ],
            "type": "object"
          },
          "ProjectedValue": {
            "description": "Closed and bounded wire representation of every current `PropertyValue` variant.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Plain bounded text.",
                "properties": {
                  "format": {
                    "const": "text",
                    "type": "string"
                  },
                  "text": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded text value."
                  }
                },
                "required": [
                  "format",
                  "text"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Validated finite practical JSON number.",
                "properties": {
                  "format": {
                    "const": "number",
                    "type": "string"
                  },
                  "number": {
                    "$ref": "#/$defs/ProjectedNumber",
                    "description": "Finite bounded numeric value."
                  }
                },
                "required": [
                  "format",
                  "number"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "One closed select option.",
                "properties": {
                  "format": {
                    "const": "select",
                    "type": "string"
                  },
                  "select": {
                    "$ref": "#/$defs/ProjectedTag",
                    "description": "Selected tag option."
                  }
                },
                "required": [
                  "format",
                  "select"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "A bounded list of closed select options.",
                "properties": {
                  "format": {
                    "const": "multi_select",
                    "type": "string"
                  },
                  "multi_select": {
                    "$ref": "#/$defs/BoundedList100OfProjectedTag",
                    "description": "Selected tag options."
                  }
                },
                "required": [
                  "format",
                  "multi_select"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded RFC 3339-like upstream date text.",
                "properties": {
                  "date": {
                    "$ref": "#/$defs/ProjectedDate",
                    "description": "Bounded date text."
                  },
                  "format": {
                    "const": "date",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "date"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded file references.",
                "properties": {
                  "files": {
                    "$ref": "#/$defs/BoundedList100OfEntityId",
                    "description": "Validated file identifiers."
                  },
                  "format": {
                    "const": "files",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "files"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Boolean checkbox value.",
                "properties": {
                  "checkbox": {
                    "description": "Checkbox state.",
                    "type": "boolean"
                  },
                  "format": {
                    "const": "checkbox",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "checkbox"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded URL value.",
                "properties": {
                  "format": {
                    "const": "url",
                    "type": "string"
                  },
                  "url": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded URL text."
                  }
                },
                "required": [
                  "format",
                  "url"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded email value.",
                "properties": {
                  "email": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded email text."
                  },
                  "format": {
                    "const": "email",
                    "type": "string"
                  }
                },
                "required": [
                  "format",
                  "email"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded phone value.",
                "properties": {
                  "format": {
                    "const": "phone",
                    "type": "string"
                  },
                  "phone": {
                    "$ref": "#/$defs/BoundedText4096",
                    "description": "Bounded phone text."
                  }
                },
                "required": [
                  "format",
                  "phone"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "Bounded validated object identifiers.",
                "properties": {
                  "format": {
                    "const": "objects",
                    "type": "string"
                  },
                  "objects": {
                    "$ref": "#/$defs/BoundedList100OfEntityId",
                    "description": "Validated referenced object identifiers."
                  }
                },
                "required": [
                  "format",
                  "objects"
                ],
                "type": "object"
              }
            ]
          },
          "SpaceId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._~-]+$",
            "type": "string"
          },
          "TypeKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "description": "Items in this page, never more than 100.",
            "items": {
              "$ref": "#/$defs/ObjectOutput"
            },
            "maxItems": 100,
            "type": "array"
          },
          "next_cursor": {
            "$ref": "#/$defs/CursorToken",
            "description": "Opaque continuation cursor, absent at the end."
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    }
  ]
