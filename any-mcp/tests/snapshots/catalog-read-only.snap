    {
      "annotations": {
        "destructiveHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List one bounded page of template summaries for one resolved type. Returns no template bodies.",
      "inputSchema": {
        "$defs": {
          "CursorToken": {
            "maxLength": 64,
            "minLength": 52,
            "pattern": "^c[0-9]+\\.[0-9a-f]{16}\\.[0-9a-f]{32}$",
            "type": "string"
          },
          "DiscoveryReference": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "PageLimit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "$ref": "#/$defs/CursorToken"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque continuation cursor, when continuing the same request."
          },
          "limit": {
            "$ref": "#/$defs/PageLimit",
            "default": 20,
            "description": "Requested item limit, defaulting to 20."
          },
          "space": {
            "$ref": "#/$defs/DiscoveryReference",
            "description": "Unique space name or identifier."
          },
          "type": {
            "$ref": "#/$defs/DiscoveryReference",
