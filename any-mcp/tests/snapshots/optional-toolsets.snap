                "description": "Whether the test-only operation completed.",
                "type": "boolean"
              }
            },
            "required": [
              "complete"
            ],
            "type": "object"
          }
        },
        {
          "annotations": {
            "destructiveHint": false,
            "openWorldHint": false,
            "readOnlyHint": true
