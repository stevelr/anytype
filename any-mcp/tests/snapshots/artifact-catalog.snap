            "$ref": "#/$defs/ArtifactDestination",
            "description": "Authorized create-new root-relative local destination."
          },
          "expected_strong_etag": {
            "description": "Optional strong representation validator required by the caller.",
            "maxLength": 256,
            "minLength": 2,
            "pattern": "^\"[\\x21\\x23-\\x7e]*\"$",
