              "failed"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "canonical_sha256": {
            "description": "SHA-256 of the complete canonical Markdown read back from Anytype.",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "dispatched_chars": {
            "description": "Exact dispatched Unicode scalar count.",
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          },
          "dispatched_sha256": {
            "description": "SHA-256 of the complete Markdown dispatched to Anytype.",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "no_op": {
            "description": "Whether update verification proved that no mutation was necessary.",
            "type": "boolean"
          },
          "object_id": {
            "description": "Exact created or updated Anytype object identity.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "reused": {
            "description": "Whether a completed process-generation idempotency result was reused.",
            "type": "boolean"
          },
          "source_bytes": {
            "description": "Exact source byte count.",
            "maximum": 67108864,
            "minimum": 0,
            "type": "integer"
          },
          "source_consumed": {
            "description": "Whether a ready remote source was consumed after verified success.",
            "type": "boolean"
          },
          "source_sha256": {
            "description": "SHA-256 of the exact authorized source bytes.",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "space_id": {
            "description": "Canonical Anytype space identity.",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "validators": {
            "description": "Bounded results from startup-configured validator policies.",
            "items": {
              "$ref": "#/$defs/ValidatorFinding"
            },
            "maxItems": 16,
            "type": "array"
          }
        },
        "required": [
          "space_id",
          "object_id",
          "source_sha256",
          "dispatched_sha256",
          "canonical_sha256",
          "source_bytes",
          "dispatched_chars",
          "no_op",
          "source_consumed",
          "reused",
          "validators"
        ],
        "type": "object"
      }
