                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "$ref": "#/$defs/ArtifactState",
                "description": "Terminal state proven by this operation."
              },
              "stored_media_type": {
                "description": "Canonical MIME essence reported by the completed representation.",
                "maxLength": 255,
                "minLength": 3,
                "type": [
                  "string",
                  "null"
                ]
              },
              "validators": {
                "description": "Bounded results from startup-configured validator policies.",
                "items": {
                  "$ref": "#/$defs/ValidatorFinding"
                },
                "maxItems": 16,
                "type": "array"
              }
            },
            "required": [
              "direction",
              "state",
              "space_id",
              "size_bytes",
              "sha256",
              "validators"
            ],
            "type": "object"
          },
          "ArtifactState": {
            "enum": [
              "consumed",
              "available"
            ],
            "type": "string"
          },
          "ValidatorFinding": {
            "additionalProperties": false,
            "description": "Bounded public result from one startup-configured validator.",
            "properties": {
              "detected_media_type": {
                "description": "Bounded detected MIME essence for a successful `file-mime` driver.",
                "maxLength": 255,
                "minLength": 3,
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Stable configured logical validator ID.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/ValidatorStatus",
                "description": "Closed completion category."
              }
            },
            "required": [
              "id",
              "status"
            ],
            "type": "object"
          },
          "ValidatorStatus": {
            "enum": [
              "accepted",
              "rejected",
              "unavailable",
              "skipped",
              "failed"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "description": "Canonical Anytype file object exported.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "receipt": {
            "$ref": "#/$defs/ArtifactReceipt",
            "description": "Bounded proof of verified create-new publication."
          }
        },
        "required": [
          "file_id",
          "receipt"
        ],
        "type": "object"
      }
