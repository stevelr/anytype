    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Replace one exact Anytype document body from a complete authorized UTF-8 artifact after checking the required current-body hash. A canonical no-op performs no mutation.",
      "inputSchema": {
        "$defs": {
          "ArtifactLocalLocation": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "description": "Portable UTF-8 path relative to the selected root; exactly one path form is required.",
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "path_native": {
                "additionalProperties": false,
                "description": "Platform-native encoded path relative to the selected root; exactly one path form is required.",
                "properties": {
                  "encoding": {
                    "description": "Closed encoding for the current platform's native path representation.",
                    "enum": [
                      "unix-bytes-base64url",
                      "windows-wtf16le-base64url"
                    ],
                    "type": "string"
                  },
                  "value": {
                    "description": "Canonical unpadded base64url native path bytes or code units.",
                    "maxLength": 5462,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "type": "string"
                  }
                },
                "required": [
                  "encoding",
                  "value"
                ],
                "type": "object"
              },
              "root": {
                "description": "Canonical logical ID of one configured local artifact root.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "root"
            ],
            "type": "object"
          },
          "ArtifactSource": {
            "additionalProperties": false,
            "properties": {
              "local": {
                "$ref": "#/$defs/ArtifactLocalLocation",
                "description": "Authorized local source, mutually exclusive with `staged_handle`."
              },
              "staged_handle": {
                "description": "Opaque ready staging bearer, mutually exclusive with `local`.",
                "maxLength": 128,
                "minLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "DocumentSourceFormat": {
            "oneOf": [
              {
                "const": "markdown",
                "description": "Interpret the artifact as complete Markdown.",
                "type": "string"
              },
              {
                "const": "plain_text",
                "description": "Escape the artifact as literal plain text before dispatch.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "expected_body_sha256": {
            "description": "Required SHA-256 of the current complete canonical Markdown body.",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "idempotency_key": {
            "description": "Stable caller key preventing an accidental second replacement.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "object_id": {
            "description": "Exact Anytype object identifier; names are never guessed.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/ArtifactSource",
            "description": "Authorized local or staged UTF-8 replacement body."
          },
          "source_format": {
            "$ref": "#/$defs/DocumentSourceFormat",
            "description": "Whether source bytes are complete Markdown or literal plain text."
          },
          "space": {
            "description": "Exact Anytype space ID or configured resolvable space name.",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "space",
          "object_id",
          "source",
          "source_format",
          "expected_body_sha256",
          "idempotency_key"
        ],
        "type": "object"
      },
