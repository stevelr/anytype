          },
          "ArtifactReceipt": {
            "additionalProperties": false,
            "properties": {
              "declared_media_type": {
                "description": "Canonical MIME essence asserted at import, when supplied.",
                "maxLength": 255,
                "minLength": 3,
                "type": [
                  "string",
                  "null"
                ]
              },
              "direction": {
                "$ref": "#/$defs/ArtifactDirection",
                "description": "Direction in which bytes moved relative to Anytype."
              },
              "root_id": {
                "description": "Logical root ID used without exposing a physical path.",
                "maxLength": 128,
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "description": "Lowercase SHA-256 of the verified bytes.",
                "maxLength": 64,
                "minLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "size_bytes": {
                "description": "Exact byte length of the verified artifact.",
                "maximum": 1073741824,
                "minimum": 0,
                "type": "integer"
              },
              "space_id": {
                "description": "Canonical Anytype space identity bound to the receipt.",
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "staging_handle": {
                "description": "Opaque remote bearer returned separately from the staging URL.",
                "maxLength": 128,
                "minLength": 64,
                "type": [
                  "string",
                  "null"
                ]
              },
              "staging_record": {
                "description": "Non-secret remote record identifier when staged.",
                "maxLength": 32,
                "minLength": 32,
                "type": [
                  "string",
                  "null"
                ]
              },
              "staging_url": {
                "description": "Fixed remote download URL containing no bearer credential.",
                "maxLength": 2048,
                "minLength": 1,
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "$ref": "#/$defs/ArtifactState",
                "description": "Terminal state proven by this operation."
              },
              "stored_media_type": {
                "description": "Canonical MIME essence reported by the completed representation.",
                "maxLength": 255,
                "minLength": 3,
                "type": [
                  "string",
                  "null"
                ]
              },
              "validators": {
                "description": "Bounded results from startup-configured validator policies.",
                "items": {
                  "$ref": "#/$defs/ValidatorFinding"
                },
                "maxItems": 16,
                "type": "array"
              }
            },
            "required": [
              "direction",
              "state",
              "space_id",
              "size_bytes",
              "sha256",
              "validators"
            ],
            "type": "object"
          },
          "ArtifactState": {
            "enum": [
              "consumed",
              "available"
            ],
            "type": "string"
          },
          "ValidatorFinding": {
            "additionalProperties": false,
            "description": "Bounded public result from one startup-configured validator.",
            "properties": {
              "detected_media_type": {
                "description": "Bounded detected MIME essence for a successful `file-mime` driver.",
                "maxLength": 255,
                "minLength": 3,
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "Stable configured logical validator ID.",
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/ValidatorStatus",
                "description": "Closed completion category."
              }
            },
            "required": [
              "id",
              "status"
            ],
            "type": "object"
          },
          "ValidatorStatus": {
            "enum": [
              "accepted",
              "rejected",
              "unavailable",
              "skipped",
              "failed"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "description": "Canonical Anytype file object created or safely reused.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "receipt": {
            "$ref": "#/$defs/ArtifactReceipt",
            "description": "Bounded proof of verified import completion."
          },
          "reused": {
            "description": "Whether the result came from verified idempotency state.",
            "type": "boolean"
          }
        },
        "required": [
          "file_id",
          "receipt",
          "reused"
        ],
        "type": "object"
      }
    }
  ]
}
